{
  "name": "scribe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.node.json && vite build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "package:prepare": "./scripts/bundle-whisper-cli.sh && ./scripts/fetch-whisper-model.sh && ./scripts/bundle-speexdsp.sh",
    "package:mac": "bun run package:prepare && tauri build --bundles app",
    "package:mac:dmg": "bun run package:prepare && tauri build --bundles dmg",
    "test:frontend": "bun test tests/frontend",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
